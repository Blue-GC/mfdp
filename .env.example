# ============================================================
# MODEL FILE DEFINITION PROTOCOL
# ============================================================
# - IMPORTANT: Rename this file from ".env.example" to ".env" and place it in the project root directory.
#              The MFDP servers and bindings require a .env file in the project root and will refuse to start without it.
#              -- Commands -----------------------------------
#              ANY OS (recommended): make setup   (or: node scripts/index.js setup)
#              COMMAND PROMPT: ren .env.example .env
#              POWERSHELL: Rename-Item .env.example .env
#              LINUX: mv .env.example .env
# ============================================================

# CONFIGURATION
APP_INFO=./config/config.json # Do not change unless you need to use a different application configuration file.
PROGRAMMING_ADAPTERS=default # Set this to a configuration filename without the .json extension. The file must be located in ./config/adapters/.

# APIs & Pages
API_HOST=127.0.0.1 # Use 0.0.0.0 only behind HTTPS and with REQUIRE_SECRET=true.
WEBPAGE_PORT=3848
API_PORT=3847

# FILES
WORKSPACE_ROOT=. # The HTTP API only reads source files inside this directory (relative to the project root).
ARTIFACT_DIR=./artifacts # The HTTP API only writes and reads .mfdp artifacts inside this directory.

# AUTHENTICATION
REQUIRE_SECRET=false # Set this to true to require SECRET-based authentication for the HTTP and Binding APIs.
SECRET=YOUR_BASE64_ENCODED_SECRET_HERE # Edit this if you set REQUIRE_SECRET=true, otherwise this won't take effect.
CLIENTS_WHITELIST=true # Also accepted with the older spelling CLIENTS_WHITLIST.
AUTHORIZED_CLIENTS=./config/clients.json # Only change this path if necessary. Edit clients.json to configure which clients are authorized to connect. This setting applies to the HTTP API only.

# ============================================================
# CONFIGURATION RECOMMENDATIONS, DO'S & DON'TS
# ============================================================
#
# DO:
# - Generate a unique secret for each deployment using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" or whatever your prefered method.
#   (make setup does this for you.)
# - Keep your secret confidential and configuration up to date.
# - Use HTTPS when exposing the HTTP API over a network.
# - Restrict API access to trusted clients and networks.
#
# --------------------------------------------------------
#
# DON'T:
# - Share your SECRET with untrusted parties.
# - Commit real production secrets to public repositories.
# - Reuse secrets across unrelated deployments.
# - Send SECRET in URLs or expose it in logs.
# - Set REQUIRE_SECRET=false when authentication is needed
#   to protect your HTTP API.
#
# SECURITY:
# When REQUIRE_SECRET=true, clients must authenticate every
# applicable MFDP HTTP API request using SECRET.
# Keep SECRET confidential and replace the placeholder with
# your own generated value before enabling authentication.
#
# ============================================================
